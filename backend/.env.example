# Copy to backend/.env for local development. Never commit real secrets.
PORT=5000
MONGODB_URI=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_TIMEOUT_MS=25000
AI_MAX_CONTEXT_CHARS=90000
AI_APP_NAME=BiteCode Control
AI_APP_URL=http://localhost:5173

# Judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_PYTHON_ID=71
JUDGE0_JAVASCRIPT_ID=63
JUDGE0_C_ID=50
JUDGE0_CPP_ID=54
JUDGE0_JAVA_ID=62
JUDGE0_CSHARP_ID=51
JUDGE0_GO_ID=60
JUDGE0_RUST_ID=73
JUDGE0_PHP_ID=68
JUDGE0_RUBY_ID=72
JUDGE0_KOTLIN_ID=78

# Optional Mongo DNS/fallback settings
MONGODB_DNS_SERVERS=
MONGODB_FALLBACK_HOSTS=
MONGODB_REPLICA_SET=
MONGO_CONNECT_ATTEMPTS=8
AUTO_SEED=true
UPLOAD_DIR=uploads
ADMIN_EMAIL=
ADMIN_PASSWORD=
